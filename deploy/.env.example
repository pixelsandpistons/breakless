# Copy to .env beside docker-compose.yml. Names are gluetun's: https://github.com/qdm12/gluetun-wiki
VPN_SERVICE_PROVIDER=private internet access
VPN_TYPE=openvpn
OPENVPN_USER=
OPENVPN_PASSWORD=
# For a WireGuard provider leave the two above empty and set these instead:
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
# Where Twitch sells no adverts. Measure before trusting a country (README).
SERVER_COUNTRIES=Iceland
# Who owns the data folder. `id -u` and `id -g`.
PUID=1000
PGID=1000
TZ=UTC
# Where the followed channels and the advert log are kept.
DATA=./data
# The address the service listens on. 127.0.0.1 is this machine only; 0.0.0.0 is your whole LAN.
BIND=127.0.0.1
# The host:port people open the page at; Twitch's chat frame refuses a mismatch.
TWITCH_HOST=localhost:8080
